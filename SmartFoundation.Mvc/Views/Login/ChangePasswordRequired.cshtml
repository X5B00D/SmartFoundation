@{
    Layout = null;
    ViewData["Title"] = "تغيير كلمة المرور مطلوب";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="request-verification-token" content="@antiforgeryToken" />
    <title>تغيير كلمة المرور مطلوب</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-900 text-white">
    <main class="mx-auto flex min-h-screen max-w-2xl items-center px-4 py-10">
        <section class="w-full rounded-xl border border-slate-700 bg-slate-800 p-6 shadow-2xl md:p-8">
            <h1 class="mb-3 text-2xl font-bold text-yellow-300">يجب تغيير كلمة المرور</h1>
            <p class="mb-2 text-slate-200">تم تسجيل الدخول باستخدام كلمة مرور مؤقتة.</p>
            <p class="mb-6 text-slate-300">يجب تغيير كلمة المرور قبل استخدام النظام. صلاحية كلمة المرور المؤقتة 24 ساعة من وقت إعادة التعيين.</p>

            <div id="password-error" class="mb-4 hidden rounded-lg border border-red-500 bg-red-950 p-3 text-red-200"></div>

            <form id="change-password-required-form" class="space-y-4">
                <div>
                    <label for="current-password" class="mb-2 block">كلمة المرور الحالية</label>
                    <input id="current-password" name="currentPassword" type="password" autocomplete="current-password" required
                           class="w-full rounded-lg border border-slate-600 bg-slate-700 p-3 text-white" />
                </div>
                <div>
                    <label for="new-password" class="mb-2 block">كلمة المرور الجديدة</label>
                    <input id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="8" required
                           class="w-full rounded-lg border border-slate-600 bg-slate-700 p-3 text-white" />
                    <p class="mt-1 text-sm text-slate-400">8 خانات على الأقل، وتتضمن حرفًا كبيرًا وحرفًا صغيرًا ورقمًا.</p>
                </div>
                <div>
                    <label for="confirm-password" class="mb-2 block">تأكيد كلمة المرور الجديدة</label>
                    <input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required
                           class="w-full rounded-lg border border-slate-600 bg-slate-700 p-3 text-white" />
                </div>
                <button type="submit" class="w-full rounded-lg bg-blue-600 px-4 py-3 font-bold hover:bg-blue-700">
                    تغيير كلمة المرور وتسجيل الدخول مجددًا
                </button>
            </form>

            <form method="post" action="/Login/Logout" class="mt-5 text-center">
                @Html.AntiForgeryToken()
                <button type="submit" class="text-slate-300 underline">تسجيل الخروج</button>
            </form>
        </section>
    </main>
    <script src="~/js/antiforgery.js" asp-append-version="true"></script>
    <script src="~/js/change-password-required.js" asp-append-version="true"></script>
</body>
</html>
